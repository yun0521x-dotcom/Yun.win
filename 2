-- ========== 核心戰鬥迴圈 (VOID_LOCK & 3D Surround RAGE) ==========
local isVoidLockActive = false
local originalPosition = nil
local lastHealth = 100

local isRageActive = false
local rageOriginalPos = nil
local currentRageTarget = nil

task.spawn(function()
    while true do
        task.wait(0.1)
        if isRageActive then
            local char = player.Character
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
            if rootPart then
                local nearestHum, nearestRoot, nearestName = nil, nil, "NO_TARGET"
                local shortestDist = math.huge
                for _, op in ipairs(Players:GetPlayers()) do
                    if op ~= player and op.Character then
                        local oRoot = op.Character:FindFirstChild("HumanoidRootPart")
                        local oHum = op.Character:FindFirstChildOfClass("Humanoid")
                        if oRoot and oHum and oHum.Health > 0 then
                            local dist = (rootPart.Position - oRoot.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                nearestHum = oHum
                                nearestRoot = oRoot
                                nearestName = op.Name
                            end
                        end
                    end
                end
                currentRageTarget = { root = nearestRoot, hum = nearestHum, name = nearestName }
            else
                currentRageTarget = nil
            end
        end
    end
end)

RunService.Stepped:Connect(function()
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not rootPart or not hum then return end

    if isVoidLockActive then
        if hum.Health < lastHealth then
            isUnderAttack = true
            subtitle.Text = "!! WARNING: UNDER ATTACK !!"
            subtitle.TextColor3 = COLORS.Danger
            task.delay(0.8, function()
                if isVoidLockActive then subtitle.Text = "SECURE_HUD // v3.9_RESTORE_FIX"; subtitle.TextColor3 = COLORS.Accent; isUnderAttack = false end
            end)
        end
        lastHealth = hum.Health
        if originalPosition then
            local teleRange = 40
            local offsetX = (math.random() * 2 - 1) * teleRange
            local offsetZ = (math.random() * 2 - 1) * teleRange
            local targetY = originalPosition.Y - _G.VoidDepthOffset
            rootPart.CFrame = CFrame.new(originalPosition.X + offsetX, targetY, originalPosition.Z + offsetZ)
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
        end
    elseif isRageActive then
        hum.AutoRotate = false
        for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
        if currentRageTarget and currentRageTarget.root and currentRageTarget.hum.Health > 0 then
            local enemyRoot = currentRageTarget.root
            local curHp = math.floor(currentRageTarget.hum.Health + 0.5)
            local maxHp = math.floor(currentRageTarget.hum.MaxHealth + 0.5)
            hpValueLabel.Text = string.format("%s: %d/%d", currentRageTarget.name, curHp, maxHp)
            local hpRatio = math.clamp(currentRageTarget.hum.Health / currentRageTarget.hum.MaxHealth, 0, 1)
            hpBarFill.Size = UDim2.new(hpRatio, 0, 1, 0)

            local t = tick() * 12
            local radius = 3.5
            local angle = t % (math.pi * 2)
            local offsetX = math.cos(angle) * radius
            local offsetZ = math.sin(angle) * radius
            local offsetY = math.sin(t * 1.5) * 2.5

            local targetPos = enemyRoot.Position + Vector3.new(offsetX, offsetY, offsetZ)
            rootPart.CFrame = CFrame.lookAt(targetPos, enemyRoot.Position)
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
        else
            hpValueLabel.Text = "NO_TARGET"
            hpBarFill.Size = UDim2.new(0, 0, 1, 0)
            if rageOriginalPos then rootPart.CFrame = CFrame.new(rageOriginalPos) end
        end
    end
end)

