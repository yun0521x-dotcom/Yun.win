    Instance.new("UIStroke", container).Color = COLORS.Border

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 12, 0, 4)
    label.Size = UDim2.new(0.6, 0, 0, 16)
    label.Font = Enum.Font.Code
    label.Text = labelText
    label.TextColor3 = COLORS.SubText
    label.TextSize = 12
    label.ZIndex = 2
    label.Parent = container

    local valueLabel = Instance.new("TextLabel")
    valueLabel.BackgroundTransparency = 1
    valueLabel.Position = UDim2.new(0.4, 0, 0, 4)
    valueLabel.Size = UDim2.new(0.55, 0, 0, 16)
    valueLabel.Font = Enum.Font.Code
    valueLabel.Text = tostring(default) .. (unitSuffix or "")
    valueLabel.TextColor3 = COLORS.Accent
    valueLabel.TextSize = 12
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.ZIndex = 2
    valueLabel.Parent = container

    local track = Instance.new("Frame")
    track.Position = UDim2.new(0, 12, 0, 28)
    track.Size = UDim2.new(1, -24, 0, 4)
    track.BackgroundColor3 = COLORS.Track
    track.ZIndex = 2
    track.Parent = container

    local fillRatio = (default - min) / (max - min)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(fillRatio, 0, 1, 0)
    fill.BackgroundColor3 = COLORS.Accent
    fill.ZIndex = 2
    fill.Parent = track

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 4, 0, 12)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(fillRatio, 0, 0.5, 0)
    knob.BackgroundColor3 = COLORS.Accent
    knob.ZIndex = 3
    knob.Parent = track

    local dragButton = Instance.new("TextButton")
    dragButton.BackgroundTransparency = 1
    dragButton.Text = ""
    dragButton.Size = UDim2.new(1, 10, 1, 16)
    dragButton.Position = UDim2.new(0, -5, 0.5, -8)
    dragButton.ZIndex = 4
    dragButton.Parent = track

    local dragging = false
    local function updateFromInputX(inputX)
        local ratio = math.clamp((inputX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local value = min + (max - min) * ratio
        if isDecimal then
            value = math.floor(value * 10 + 0.5) / 10
            valueLabel.Text = string.format("%.1f%s", value, unitSuffix or "")
        else
            value = math.floor(value + 0.5)
            valueLabel.Text = tostring(value) .. (unitSuffix or "")
        end
        fill.Size = UDim2.new((value - min)/(max - min), 0, 1, 0)
        knob.Position = UDim2.new((value - min)/(max - min), 0, 0.5, 0)
        if onChanged then onChanged(value) end
    end

    dragButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInputX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInputX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

