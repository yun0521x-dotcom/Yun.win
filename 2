        rageOriginalPos = nil
        currentRageTarget = nil
        hpValueLabel.Text = "OFF / NO_TARGET"
        hpBarFill.Size = UDim2.new(0, 0, 1, 0)
        btn.Text = "OFF"
        btn.TextColor3 = COLORS.Accent
        btn.BackgroundColor3 = COLORS.AccentDim
    end
end)

