local function restoreOriginalPosition()
    if not originalCFrame then return end
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            hrp.CFrame = originalCFrame
        end
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
    end
    originalCFrame = nil
end

local function disconnectStatus()
    if statusConn then
        statusConn:Disconnect()
        statusConn = nil
    end
end

local function fullStop(reason)
    isVoidLockActive = false
    engaged = false
    disconnectStatus()
    restoreOriginalPosition()
    lockCenterX = nil
    lockCenterZ = nil
    lockHalfX = 0
    lockHalfZ = 0

    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        if hum then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Landed) end)
        end
    end

    local btn = _G.__yun_VoidLockBtn
    if btn then
        btn.Text = "OFF"
        btn.TextColor3 = COLORS.Accent
        btn.BackgroundColor3 = COLORS.AccentDim
    end
end

local function watchDuel(duel)
    disconnectStatus()
    statusConn = duel:GetDataChangedSignal("Status"):Connect(function()
        if not isVoidLockActive then return end
        local status = duel:Get("Status")
        if status == "RoundStarted" and not engaged then
            engaged = true
        elseif status == "RoundFinished" then
            fullStop("Round finished")
        elseif status == "GameOver" then
            fullStop("Game over")
        end
    end)
end

local function startVoidEdge()
    if isVoidLockActive then return end
    if not voidEdge then return end
    if not DuelController_m then return end

    local duel = DuelController_m:GetDuel(player)
    if not duel then return end

    isVoidLockActive = true
    engaged = false
    originalCFrame = nil
    lockCenterX = nil
    lockCenterZ = nil
    lockHalfX = 0
    lockHalfZ = 0
    watchDuel(duel)

    local status = duel:Get("Status")
    if status == "RoundStarted" then
        engaged = true
    end
end

local function stopVoidEdge()
    fullStop("OFF")
end

_trackConn(RunService.Heartbeat:Connect(function()
    if not _epochAlive() then return end
    if not isVoidLockActive or not engaged or not voidEdge then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not originalCFrame then
        originalCFrame = hrp.CFrame
    end

    if not lockCenterX then
        lockCenterX = voidEdge.x or ((voidEdge.minX + voidEdge.maxX) / 2)
        lockCenterZ = voidEdge.z or ((voidEdge.minZ + voidEdge.maxZ) / 2)
        local safeHalfX = (voidEdge.maxX - voidEdge.minX) / 2 - 5
        local safeHalfZ = (voidEdge.maxZ - voidEdge.minZ) / 2 - 5
        lockHalfX = math.max(0, math.min(VOID_SPREAD, safeHalfX))
        lockHalfZ = math.max(0, math.min(VOID_SPREAD, safeHalfZ))
    end

    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end

    local offsetX = (math.random() * 2 - 1) * lockHalfX
    local offsetZ = (math.random() * 2 - 1) * lockHalfZ
    local targetX = lockCenterX + offsetX
    local targetZ = lockCenterZ + offsetZ

    hrp.CFrame = CFrame.new(targetX, voidEdge.y, targetZ)
    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end))

