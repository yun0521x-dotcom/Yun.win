-- ========== RAGE ==========
local isRageActive = false
local rageOriginalPos = nil
local currentRageTarget = nil
local rageSnapshot = {}

local function snapshotChar(char)
    rageSnapshot = {}
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            rageSnapshot[p] = {
                CanCollide = p.CanCollide,
                CollisionGroup = p.CollisionGroup,
            }
        end
    end
end

local function restoreCharSnapshot()
    for part, data in pairs(rageSnapshot) do
        if part and part.Parent then
            pcall(function() part.CanCollide = data.CanCollide end)
            pcall(function() part.CollisionGroup = data.CollisionGroup end)
        end
    end
    rageSnapshot = {}
end

task.spawn(function()
    while _epochAlive() do
        task.wait(0.1)
        if isRageActive then
            local char = player.Character
            local rootPart = char and char:FindFirstChild("HumanoidRootPart")
            if rootPart then
                local nearestHum, nearestRoot, nearestName = nil, nil, "NO_TARGET"
                local shortestDist = math.huge
                for _, op in ipairs(Players:GetPlayers()) do
                    if op ~= player and op.Character then
                        local oRoot = op.Character:FindFirstChild("HumanoidRootPart")
                        local oHum = op.Character:FindFirstChildOfClass("Humanoid")
                        if oRoot and oHum and oHum.Health > 0 then
                            local dist = (rootPart.Position - oRoot.Position).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                nearestHum = oHum
                                nearestRoot = oRoot
                                nearestName = op.Name
                            end
                        end
                    end
                end
                currentRageTarget = { root = nearestRoot, hum = nearestHum, name = nearestName }
            else
                currentRageTarget = nil
            end
        end
    end
end)

_trackConn(RunService.Heartbeat:Connect(function()
    if not _epochAlive() then return end
    local char = player.Character
    if not char then return end
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not rootPart or not hum then return end

    if isRageActive then
        hum.AutoRotate = false
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
                pcall(function() part.CollisionGroup = RAGE_CG end)
            end
        end
        if currentRageTarget and currentRageTarget.root and currentRageTarget.hum.Health > 0 then
            local enemyRoot = currentRageTarget.root
            local curHp = math.floor(currentRageTarget.hum.Health + 0.5)
            local maxHp = math.floor(currentRageTarget.hum.MaxHealth + 0.5)
            hpValueLabel.Text = string.format("%s: %d/%d", currentRageTarget.name, curHp, maxHp)
            local hpRatio = math.clamp(currentRageTarget.hum.Health / currentRageTarget.hum.MaxHealth, 0, 1)
            hpBarFill.Size = UDim2.new(hpRatio, 0, 1, 0)

            local t = tick() * 12
            local radius = 2.5
            local angle = t % (math.pi * 2)
            local offsetX = math.cos(angle) * radius
            local offsetZ = math.sin(angle) * radius
            local offsetY = math.sin(t * 1.5) * 2.0

            local targetPos = enemyRoot.Position + Vector3.new(offsetX, offsetY, offsetZ)
            rootPart.CFrame = CFrame.lookAt(targetPos, enemyRoot.Position)
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
        else
            hpValueLabel.Text = "NO_TARGET"
            hpBarFill.Size = UDim2.new(0, 0, 1, 0)
            if rageOriginalPos then
                rootPart.CFrame = CFrame.new(rageOriginalPos)
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
end))

