local VOID_SPREAD = 100
local VOID_SAFE_MARGIN = 0.01

local function findMapRoot()
    for _, v in ipairs(workspace:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Barriers") then
            return v
        end
    end
    return nil
end

local FLOOR_SIZE_THRESHOLD = 400
local function computeVoidEdge(mapRoot)
    local barriers = mapRoot:FindFirstChild("Barriers")
    if not barriers then return nil end

    local lowestPart = nil
    for _, part in ipairs(barriers:GetDescendants()) do
        if part:IsA("BasePart") and CollectionService:HasTag(part, "OutOfBoundsPart") then
            local warn = part:GetAttribute("WarnDelay")
            local kill = part:GetAttribute("KillDelay")
            if warn == 0 and kill == 0 then
                if not lowestPart or part.Position.Y < lowestPart.Position.Y then
                    lowestPart = part
                end
            end
        end
    end

    if not lowestPart then return nil end

    local baseY = lowestPart.Position.Y
    local minX, maxX = math.huge, -math.huge
    local minZ, maxZ = math.huge, -math.huge
    local found = false
    for _, part in ipairs(barriers:GetDescendants()) do
        if part:IsA("BasePart") and CollectionService:HasTag(part, "OutOfBoundsPart") then
            local warn = part:GetAttribute("WarnDelay")
            local kill = part:GetAttribute("KillDelay")
            if warn == 0 and kill == 0 and math.abs(part.Position.Y - baseY) < 5 then
                found = true
                local hx = part.Size.X / 2
                local hz = part.Size.Z / 2
                minX = math.min(minX, part.Position.X - hx)
                maxX = math.max(maxX, part.Position.X + hx)
                minZ = math.min(minZ, part.Position.Z - hz)
                maxZ = math.max(maxZ, part.Position.Z + hz)
            end
        end
    end

    if not found then return nil end

    local bottomFaceY = lowestPart.Position.Y - (lowestPart.Size.Y / 2) - VOID_SAFE_MARGIN
    local isFloorWide = lowestPart.Size.X > FLOOR_SIZE_THRESHOLD and lowestPart.Size.Z > FLOOR_SIZE_THRESHOLD
    return {
        y = bottomFaceY,
        x = isFloorWide and nil or lowestPart.Position.X,
        z = isFloorWide and nil or lowestPart.Position.Z,
        minX = minX, maxX = maxX,
        minZ = minZ, maxZ = maxZ,
    }
end

local function refreshMap()
    local mapRoot = findMapRoot()
    if not mapRoot then
        currentMapName = nil
        voidEdge = nil
        return
    end
    if mapRoot.Name ~= currentMapName then
        currentMapName = mapRoot.Name
        voidEdge = computeVoidEdge(mapRoot)
    end
end

